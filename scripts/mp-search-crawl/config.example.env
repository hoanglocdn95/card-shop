# Delay giua moi trang search (ms)
TCG_MP_DELAY_MS=400

# So san pham moi trang (toi da ~50, tranh 100+)
TCG_MP_PAGE_SIZE=50

# Ma phien ban frontend TCGplayer (thay doi theo thoi gian)
TCG_MP_FEV=5199

# Quoc gia ship hien thi gia (mac dinh VN)
TCG_MP_SHIPPING_COUNTRY=VN

# Tuy chon: cookie copy tu DevTools neu API tra ve loi/rong
# TCG_MP_COOKIE=TCG_VisitorKey=...; setting=CD%3DVN%26M%3D1; ...
