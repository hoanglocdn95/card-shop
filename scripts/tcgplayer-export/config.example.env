# Copy vao .env.local hoac scripts/tcgplayer-export/.env
# Dang ky API: https://docs.tcgplayer.com/docs/getting-started
# Luu y: TCGplayer co the khong cap key moi; can dung key da co san.

TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
TCGPLAYER_API_VERSION=v1.39.0

# Optional override neu discover khong tim dung category
TCGPLAYER_CATEGORY_ID_ONE_PIECE=
TCGPLAYER_CATEGORY_ID_RIFTBOUND=

# Delay giua request (ms), khuyen nghi 300-800
TCGPLAYER_DELAY_MS=300
